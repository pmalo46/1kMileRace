{
  "expo": {
    "name": "1K Miles",
    "slug": "one-k-mile-race",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "onekmiles",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.onekmiles.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF8F1",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.onekmiles.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8F1",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#120D1F"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo of the treadmill console to back up the miles you log.",
          "cameraPermission": "Take a photo of the treadmill console to back up the miles you log."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "1K Miles uses your location to measure your runs and walks while you record them.",
          "locationAlwaysAndWhenInUsePermission": "Allow location all the time so 1K Miles keeps measuring your run while your screen is locked.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9b043ce9-635e-47f6-b235-3946bdc357fa"
      }
    },
    "owner": "pmalo46"
  }
}
